{
  "name": "xuan-theme",
  "displayName": "Zhi Themes",
  "description": "Paper and ink themes from the Zhi design family.",
  "version": "0.1.0",
  "publisher": "changshun",
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "package": "npx @vscode/vsce package"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Zhi Light",
        "uiTheme": "vs",
