      },
      {
        "label": "Zhi Dark",
        "uiTheme": "vs-dark",
        "path": "./xuan-dark.json",
        "id": "Xuan Dark"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sogud/zhi.git",
    "directory": "themes/vscode"
  },
  "homepage": "https://sogud.github.io/zhi/docs/themes/",
  "bugs": {
    "url": "https://github.com/sogud/zhi/issues"
  }
}
