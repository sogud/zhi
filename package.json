{
  "name": "zhi-registry",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tokens:build": "node scripts/build-tokens.mjs",
    "registry:build": "pnpm tokens:build && shadcn build",
    "typecheck": "tsc --noEmit",
    "build": "pnpm registry:build && pnpm distribution:build && pnpm typecheck && node scripts/build-notices.mjs && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "distribution:build": "node scripts/build-distribution.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/noto-sans-sc": "^5.2.0",
    "@fontsource-variable/noto-serif-sc": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@10.20.0",
  "license": "MIT"
}
